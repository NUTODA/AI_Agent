# Copy to `.env` or `.env.browser-agent` in the project root (both are loaded; later file wins).
# Never commit real API keys.

# --- Planner (required for multi-step LLM loop) ---
BROWSER_AGENT_PLANNER_ENABLED=true

# openai_compatible | google_compatible
BROWSER_AGENT_PLANNER_PROVIDER=google_compatible

# OpenAI-compatible: e.g. https://api.openai.com/v1
# Google Gemini: API host up to /v1beta (model appended automatically), OR full generateContent URL
BROWSER_AGENT_PLANNER_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Model id (OpenAI model name, or Gemini model id e.g. gemini-2.0-flash or gemini-flash-latest)
BROWSER_AGENT_PLANNER_MODEL=zai-org/GLM-4.7

# API key (OpenAI: sk-...; Google AI Studio / Gemini: AIza...)
BROWSER_AGENT_PLANNER_API_KEY=

# Optional overrides
# BROWSER_AGENT_PLANNER_TIMEOUT_SECONDS=30
# BROWSER_AGENT_PLANNER_TEMPERATURE=0

# --- Runtime ---
# BROWSER_AGENT_HEADLESS=true
# BROWSER_AGENT_MAX_STEPS=8
# BROWSER_AGENT_TRACE_DIR=traces
# BROWSER_AGENT_ARTIFACT_DIR=artifacts
